# Static mode (default): the app reads /data/v2 copied by `npm run sync-data`.
# NEXT_PUBLIC_API_BASE=

# API mode: the frontend reads /data and /api from the backend (VPS) and does
# not ship a copy of the data. Set this on Vercel and leave the data out.
# NEXT_PUBLIC_API_BASE=https://api.example.com

# Optional override for the JSON base (defaults to <API_BASE>/data).
# NEXT_PUBLIC_DATA_BASE=
